rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection testing endpoint
    match /test/{docId} {
      allow get: if true;
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.uid == userId;
      allow update: if isOwner(userId) && request.resource.data.uid == resource.data.uid;
      allow delete: if isOwner(userId);

      // Tasks subcollection
      match /tasks/{taskId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(taskId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(taskId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      // Schedule Events subcollection
      match /events/{eventId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(eventId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(eventId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(eventId);
      }

      // Personal Project Notes subcollection
      match /notes/{noteId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(noteId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(noteId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(noteId);
      }

      // Focus sessions subcollection
      match /sessions/{sessionId} {
        allow list, get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(sessionId) && request.resource.data.userId == userId;
        allow update: if isOwner(userId) && isValidId(sessionId) && request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId) && isValidId(sessionId);
      }
    }
  }
}
